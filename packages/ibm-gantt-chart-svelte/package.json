{
  "name": "ibm-gantt-chart-svelte",
  "version": "0.5.33",
  "description": "IBM Gantt Chart Svelte Component.",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-kit sync && svelte-package && publint",
    "build:test": "vite build --emptyOutDir",
    "dev": "vite --port 3003",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "storybook": "storybook dev --port 6006",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dom": "playwright test"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "ibm-gantt-chart": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/svelte": "^8.6.18",
    "@storybook/sveltekit": "^8.6.18",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/package": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.2.0",
    "jsdom": "^26.0.0",
    "publint": "^0.3.0",
    "storybook": "^8.6.18",
    "svelte": "^5.25.0",
    "svelte-check": "^4.2.0",
    "tslib": "^2.8.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ibm/gantt-chart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibm/gantt-chart.git",
    "directory": "packages/ibm-gantt-chart-svelte"
  },
  "license": "Apache-2.0",
  "author": "IBM",
  "keywords": [
    "chart",
    "gantt",
    "svelte",
    "sveltekit",
    "component",
    "ibm",
    "timeline",
    "scheduler"
  ]
}
