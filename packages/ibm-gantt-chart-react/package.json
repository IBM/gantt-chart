{
  "name": "ibm-gantt-chart-react",
  "version": "0.5.33",
  "description": "IBM Gantt Chart React Component.",
  "repository": "https://github.com/ibm/gantt-chart",
  "keywords": [
    "chart",
    "gantt",
    "react"
  ],
  "license": "Apache-2.0",
  "contributors": [
    "Olivier Noiret (https://github.com/ono70)",
    "Gilles d'Andréa (https://github.com/gillesdandrea)"
  ],
  "type": "module",
  "main": "./dist/ibm-gantt-chart-react.umd.js",
  "module": "./dist/ibm-gantt-chart-react.es.js",
  "style": "./dist/ibm-gantt-chart-react.css",
  "source": "src/index.js",
  "exports": {
    ".": {
      "import": "./dist/ibm-gantt-chart-react.es.js",
      "require": "./dist/ibm-gantt-chart-react.umd.js"
    },
    "./dist/*.css": "./dist/*.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 3002",
    "preview": "vite preview --port 3002",
    "storybook": "storybook dev --port 9001",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:dom": "playwright test"
  },
  "dependencies": {
    "ibm-gantt-chart": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "prop-types": "^15.8.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sass": "^1.77.0",
    "storybook": "^8.6.18",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "ibm-gantt-chart": "^0.5.0",
    "prop-types": "^15.7.2",
    "react": "^16.8.6 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.6 || ^17.0.0 || ^18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
